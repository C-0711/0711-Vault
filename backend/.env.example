# 0711 Vault Backend Configuration
# Copy this to .env and update values

# ===========================================
# DOMAIN
# ===========================================
DOMAIN=localhost
ACME_EMAIL=admin@0711.io

# ===========================================
# DATABASE
# ===========================================
POSTGRES_USER=vault
POSTGRES_PASSWORD=CHANGE_ME_vault_secret_2024
POSTGRES_DB=vault

# ===========================================
# NEO4J
# ===========================================
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_neo4j_secret_2024

# ===========================================
# REDIS
# ===========================================
REDIS_PASSWORD=CHANGE_ME_redis_secret_2024

# ===========================================
# MINIO (Object Storage)
# ===========================================
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret_2024

# ===========================================
# AUTH
# ===========================================
JWT_SECRET=CHANGE_ME_generate_a_random_64_char_string_here
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_2024

# ===========================================
# MONITORING (Optional)
# ===========================================
GRAFANA_PASSWORD=CHANGE_ME_grafana_2024
